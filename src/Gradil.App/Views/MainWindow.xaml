<Window x:Class="Gradil.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gradil · Orçamento de cercas"
        Width="1100" Height="760" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CorFundo}"
        FontFamily="Segoe UI" FontSize="14"
        Foreground="{StaticResource CorTexto}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource CorPrincipal}" Padding="28,18">
            <StackPanel>
                <TextBlock Text="Gradil" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="Orçamento e pedidos de cercas" Foreground="#CFE0F0" />
            </StackPanel>
        </Border>

        <TabControl Margin="20,16,20,20" Background="Transparent" BorderThickness="0" Padding="0,16,0,0">

            <TabItem Header="  Novo orçamento  ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Cartao}">
                        <StackPanel>
                            <TextBlock Text="Dados do pedido" Style="{StaticResource TituloDoCartao}" />

                            <TextBlock Text="Comprimento da cerca (m)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Comprimento, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Altura" Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{Binding Alturas}" SelectedItem="{Binding Altura}" />

                            <TextBlock Text="Pintura" Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{Binding Pinturas}" SelectedItem="{Binding Pintura}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,8,0"
                                                    Background="{Binding CorHex}" BorderBrush="#9AA5AE" BorderThickness="1" />
                                            <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="{Binding Erro}" Foreground="{StaticResource CorErro}"
                                       TextWrapping="Wrap" Margin="0,12,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Confirmar pedido" Style="{StaticResource BotaoPrincipal}"
                                        Command="{Binding ConfirmarCommand}" />
                                <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                                        Command="{Binding CancelarCommand}" />
                            </StackPanel>

                            <TextBlock Text="{Binding Sucesso}" Foreground="{StaticResource CorSucesso}"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Cartao}">
                        <Grid>
                            <TextBlock Text="Informe o comprimento para ver o orçamento."
                                       Foreground="{StaticResource CorTextoSuave}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TemOrcamento}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Visibility="{Binding TemOrcamento, Converter={StaticResource BoolParaVisibilidade}}">
                                <TextBlock Text="Orçamento" Style="{StaticResource TituloDoCartao}" />

                                <UniformGrid Columns="3" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Cliente vai construir" Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
                                        <TextBlock Style="{StaticResource Destaque}"
                                                   Text="{Binding Orcamento.ComprimentoDesejado, StringFormat={}{0:0.00} m}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Será vendido" Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
                                        <TextBlock Style="{StaticResource Destaque}" Foreground="{StaticResource CorPrincipal}"
                                                   Text="{Binding Orcamento.ComprimentoVendido, StringFormat={}{0:0.00} m}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding Orcamento.TemDiferenca, Converter={StaticResource BoolParaVisibilidade}}">
                                        <TextBlock Text="Sobra" Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
                                        <TextBlock Style="{StaticResource Destaque}" Foreground="{StaticResource CorAviso}"
                                                   Text="{Binding Orcamento.Diferenca, StringFormat=+{0:0.00} m}" />
                                    </StackPanel>
                                </UniformGrid>

                                <DataGrid ItemsSource="{Binding Orcamento.Itens}" Width="320" HorizontalAlignment="Left">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Componente" Binding="{Binding Componente}" Width="*" />
                                        <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Cartao}"
                            Visibility="{Binding TemOrcamento, Converter={StaticResource BoolParaVisibilidade}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <TextBlock Text="Esboço da cerca" Style="{StaticResource TituloDoCartao}" />
                                <TextBlock Text="{Binding AvisoDoDesenho}" Foreground="{StaticResource CorTextoSuave}"
                                           Margin="12,3,0,0" />
                            </StackPanel>

                            <Border Background="{StaticResource CorCeu}" CornerRadius="6" Padding="16,16,16,8">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <ItemsControl ItemsSource="{Binding Desenho}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Border BorderBrush="{StaticResource CorSolo}" BorderThickness="0,0,0,3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Rectangle Width="7" Height="{Binding AlturaDoPoste}"
                                                                           Fill="{Binding Cor}" Stroke="#46525B" StrokeThickness="0.6"
                                                                           VerticalAlignment="Bottom" />
                                                                <Grid Width="120" Height="{Binding AlturaDaTela}"
                                                                      VerticalAlignment="Bottom" Margin="0,0,0,4">
                                                                    <Rectangle Fill="{Binding Cor}" Opacity="0.28" />
                                                                    <Rectangle Stroke="{Binding Cor}" StrokeThickness="2.5" />
                                                                    <Rectangle Stroke="#46525B" StrokeThickness="0.6" Margin="-1.5" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="2,50 m" FontSize="11" Foreground="{StaticResource CorTextoSuave}"
                                                                   Width="120" TextAlignment="Center" HorizontalAlignment="Right"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border BorderBrush="{StaticResource CorSolo}" BorderThickness="0,0,0,3"
                                                VerticalAlignment="Top">
                                            <Rectangle Width="7" Height="{Binding AlturaDoPoste}"
                                                       Fill="{Binding CorDaCerca}" Stroke="#46525B" StrokeThickness="0.6" />
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="  Pedidos confirmados  ">
                <Border Style="{StaticResource Cartao}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Pedidos confirmados (mais recentes primeiro)"
                                   Style="{StaticResource TituloDoCartao}" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ErroNoHistorico}"
                                   Foreground="{StaticResource CorErro}" Margin="0,0,0,8" />

                        <DataGrid ItemsSource="{Binding Pedidos}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Confirmado em" Width="180"
                                                    Binding="{Binding DataConfirmacao, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                                <DataGridTextColumn Header="Comprimento" Width="140"
                                                    Binding="{Binding Comprimento, StringFormat={}{0:0.00} m}" />
                                <DataGridTextColumn Header="Altura" Width="120"
                                                    Binding="{Binding Altura, StringFormat={}{0:0.00} m}" />
                                <DataGridTextColumn Header="Pintura" Width="*" Binding="{Binding Pintura}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
